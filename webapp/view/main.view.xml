<mvc:View controllerName="com.nubexx.hr.odatav2.controller.main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

    <Table id="idEmployeesTable"
		        items="{/Employees}"> <!--nombreModelo>/nombreListaDelJson, el modelo en este caso no tiene nombre, es "" por defecto-->
                <columns>
			        <Column width="5em">
				        <Text text="Employee ID" />
			        </Column>
                    <Column width="5em">
				        <Text text="T. of Courtesy" />
			        </Column>
                    <Column width="5em">
				        <Text text="First Name" />
			        </Column>
                    <Column width="5em">
				        <Text text="Last Name" />
			        </Column>
                    <Column width="12em">
				        <Text text="Birth Date" />
			        </Column>
                    <Column width="12em">
				        <Text text="Title" />
			        </Column>
                </columns>
                <items>
			        <ColumnListItem>
				        <cells>
                            <Text
						        text="{EmployeeID}" />
                            <Text
						        text="{TitleOfCourtesy}" />
                            <Text
						        text="{FirstName}" />
                            <Text
						        text="{LastName}" />
                            <Text
						        text="{BirthDate}" />
                            <Text
						        text="{Title}" />				        
                	    </cells>
			        </ColumnListItem>
		        </items>
        	</Table>

    </Page>
</mvc:View>