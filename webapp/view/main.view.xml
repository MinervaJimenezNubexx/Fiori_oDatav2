<mvc:View controllerName="com.nubexx.hr.odatav2.controller.main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

    <Table id="idEmployeesTable"
		        items="{/Employees}"
                mode= "SingleSelectMaster" itemPress=".onPressItem"> <!--nombreModelo>/nombreListaDelJson, el modelo en este caso no tiene nombre, es "" por defecto-->
                <columns>
			        <Column width="5em">
				        <Text text="{i18n>EmployeeID}" />
			        </Column>
                    <Column width="5em">
				        <Text text="{i18n>EmployeeMainTitleOfCourtesy}" />
			        </Column>
                    <Column width="5em">
				        <Text text="{i18n>EmployeeFirstName}" />
			        </Column>
                    <Column width="5em">
				        <Text text="{i18n>EmployeeLastName}" />
			        </Column>
                    <Column width="12em">
				        <Text text="{i18n>EmployeeMainBirthDate}" />
			        </Column>
                    <Column width="12em">
				        <Text text="{i18n>EmployeeMainTitle}" />
			        </Column>
                </columns>
                <items>
			        <ColumnListItem type= "Navigation">
				        <cells>
                            <Text
						        text="{EmployeeID}" />
                            <Text
						        text="{TitleOfCourtesy}" />
                            <Text
						        text="{FirstName}" />
                            <Text
						        text="{LastName}" />
                            <Text
						        text="{BirthDate}" />
                            <Text
						        text="{Title}" />				        
                	    </cells>
			        </ColumnListItem>
		        </items>
        	</Table>

    </Page>
</mvc:View>