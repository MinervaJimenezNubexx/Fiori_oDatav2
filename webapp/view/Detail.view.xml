<mvc:View
    controllerName="com.nubexx.hr.odatav2.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="Detail"
        title="{i18n>detailTitle}">

        <ObjectHeader
            title="{FirstName} {LastName}"
            number="{EmployeeID}"
            numberUnit="ID">

                <ObjectAttribute text="{i18n>EmployeeAddress} {Address}" />
                <ObjectAttribute text="{i18n>EmployeeBirthDate} {BirthDate}" />
                <ObjectAttribute text="{i18n>EmployeeCity} {City}" />
                <ObjectAttribute text="{i18n>EmployeeCountry} {Country}" />
                <ObjectAttribute text="{i18n>EmployeeExtension} {Extension}" />
                <ObjectAttribute text="{i18n>EmployeeHomePhone} {HomePhone}" />
                <ObjectAttribute text="{i18n>EmployeeNotes} {Notes}" />
                <ObjectAttribute text="{i18n>EmployeePostalCode} {PostalCode}" />
                <ObjectAttribute text="{i18n>EmployeeRegion} {Region}" />
                <ObjectAttribute text="{i18n>EmployeeTitle} {Title}" />
                <ObjectAttribute text="{i18n>EmployeeTitleOfCourtesy} {TitleOfCourtesy}" />

        </ObjectHeader>


        <footer>
            <Toolbar>

				<Button id = "backButton"
                    type = "Back" 
                    text = "{i18n>backButton}"
                    press = "onPress"
                    class = "sapUITinyMargin">
				</Button>

			</Toolbar>

        </footer>
    </Page>

</mvc:View>
